X_CENTER=0.5
Y_CENTER=0.5
MAX_ERROR_DEPTH=3
SCENE_LIMIT=4
MIN_SHORT_LENGTH=0
MAX_SHORT_LENGTH=0
MAX_COMBINED_SCENE_LENGTH=0
AI_PROVIDER=gemini
# Content type: gaming | esports | podcasts | interviews | news_commentary | entertainment | tv_shows | comedy | music | vlogs | cooking_diy | fitness | educational | documentaries | sports
# Non-gaming types skip the action-heuristic prefilter and let the AI pick moments
# (works best with GEMINI_DEEP_ANALYSIS=true).
VIDEO_TYPE=gaming
AI_ANALYSIS_ENABLED=true
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_DEEP_ANALYSIS=true
OPENAI_MODEL=gpt-5-mini
OPENAI_TAGGING_MODEL=gpt-5-mini
AI_SCORE_WEIGHT=0.7
CANDIDATE_CLIP_COUNT=0
CANDIDATE_CLIP_DURATION=120
ENABLE_SUBTITLES=true
SUBTITLE_MODE=ai_captions
WHISPER_MODEL=medium
MAX_CAPTIONS=0
ENABLE_AI_CAPTION_ENHANCEMENT=true
ENABLE_CAPTION_EMOJIS=true
ENABLE_TTS=true
TTS_MODEL=qwen
TTS_DEVICE=cuda
TTS_VOICE_DESCRIPTION=
TTS_GAME_AUDIO_VOLUME=0.3
TTS_VOICEOVER_VOLUME=1.0
# Allow asynchronous NVDEC initialization to finish for very short source clips.
DECORD_EOF_RETRY_MAX=1048576
DECORD_SKIP_TAIL_FRAMES=0
DEBUG_SKIP_ANALYSIS=true
DEBUG_SKIP_RENDER=true
DEBUG_RENDERED_CLIPS=

# Extra settings
# auto = match the AI-detected moment category to the VIDEO_TYPE's caption styles
CAPTION_STYLE=auto
MAX_OUTPUT_HEIGHT=1920
PYCAPS_TEMPLATE=hype
TARGET_RATIO_H=16
TARGET_RATIO_W=9
TTS_LANGUAGE=en
TTS_SPEED=1.0
TTS_USE_PRESETS=1
